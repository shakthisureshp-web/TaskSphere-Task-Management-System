# MongoDB Connection URI (e.g. mongodb://localhost:27017/taskmanager or MongoDB Atlas URI)
# If not provided, the server automatically uses the built-in persistent MongoDB store.
MONGODB_URI="mongodb://localhost:27017/taskmanager"

# JWT Secret for authentication tokens
JWT_SECRET="super-secret-jwt-key-task-manager-2026"

# Email / SMTP Configuration for real email dispatch
# (e.g. Gmail, SendGrid, Mailgun, Amazon SES, or Ethereal test account)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_FROM="TaskSphere Notifications <notifications@tasksphere.internal>"

# Admin email for task status update notifications
ADMIN_NOTIFICATION_EMAIL="admin@tasksphere.internal"

# Port (Defaults to 3000 for AI Studio)
PORT="3000"
